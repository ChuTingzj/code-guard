{
  "name": "code-guard",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @code-guard/server --filter @code-guard/web run dev",
    "dev:server": "pnpm --filter @code-guard/server dev",
    "dev:web": "pnpm --filter @code-guard/web dev",
    "build": "pnpm -r run build",
    "db:migrate": "pnpm --filter @code-guard/server prisma:migrate",
    "db:seed": "pnpm --filter @code-guard/server prisma:seed",
    "db:generate": "pnpm --filter @code-guard/server prisma:generate",
    "test:unit": "pnpm --filter @code-guard/server test:unit",
    "e2e:checklist": "bash scripts/e2e-checklist.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
