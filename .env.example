# Database
DATABASE_URL=postgresql://postgres:codeguard@localhost:5432/codeguard
POSTGRES_PASSWORD=codeguard

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# App role: gateway | worker | all
APP_ROLE=all
PORT=3001
REVIEW_CONCURRENCY=2

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Auth & encryption
JWT_SECRET=change-me-jwt-secret-min-32-chars!!
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Web
API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Seed defaults
SEED_ADMIN_EMAIL=admin@codeguard.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Admin
